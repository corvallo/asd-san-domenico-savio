---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import MainLayout from '~/app/layouts/main.astro';
import { PageHeader } from '~/features/page-header';
import { PageContent } from '~/features/page-content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');

  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { title, description, seo } = page.data;
const { Content } = await render(page);
const metaTitle = seo.title ?? `${title} | ASD San Domenico Savio`;

const metaDescription = seo.description ?? description;

const socialImage = seo.image ? new URL(seo.image, Astro.site ?? Astro.url.origin).href : undefined;
---

<MainLayout>
  <Fragment slot='head'>
    <title>{metaTitle}</title>
    <meta name='description' content={metaDescription} />

    <meta property='og:type' content='website' />
    <meta property='og:title' content={metaTitle} />
    <meta property='og:description' content={metaDescription} />

    {socialImage && <meta property='og:image' content={socialImage} />}

    {seo.noindex && <meta name='robots' content='noindex' />}
  </Fragment>
  <PageHeader title={title} subtitle={description} />
  <PageContent title={title}>
    <Content />
  </PageContent>
</MainLayout>
