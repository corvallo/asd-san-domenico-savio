{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "astro": true,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    "pnpm-lock.yaml",
    "public/images/generated/**"
  ],
  "printWidth": 120
}
