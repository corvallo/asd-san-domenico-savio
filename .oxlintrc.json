{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["node_modules/**", "dist/**", ".astro/**", "public/images/generated/**"]
}
