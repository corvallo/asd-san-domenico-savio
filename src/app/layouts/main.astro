---
import { Font } from 'astro:assets';
import '~/shared/styles/global.css';
import { Header } from '~/widgets/header';
import { MainNavigation, MobileNavigation } from '~/features/main-navigation';
import { Footer } from '~/widgets/footer';
import { getClub } from '~/entities/club';
import { Button } from '~/shared/ui';
import { getNavigation } from '~/entities/navigation';
import { Logo } from '~/features/logo';
import { HeaderRight } from '~/features/header-right';
import { ThemeSwitcher } from '~/features/theme-switcher';

const items = await getNavigation('main');
const club = await getClub();
const currentPath = Astro.url.pathname;
const trialCta = { label: 'Prova gratuita', href: '/contatti' };
---

<!doctype html>
<html lang='it'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <Font cssVariable='--font-jost' preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable='--font-cormorant' preload={[{ style: 'normal' }]} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
    <slot name='head' />
  </head>
  <body>
    <Header>
      <Logo brandName={club.name} />
      <MainNavigation items={items} currentPath={currentPath} />
      <HeaderRight>
        <ThemeSwitcher client:load />

        <!-- Island only below lg, where the sheet menu replaces the inline navigation. -->
        <MobileNavigation
          client:media='(max-width: 1023px)'
          items={items}
          currentPath={currentPath}
          title={club.name}
          cta={trialCta}
        />
      </HeaderRight>
    </Header>
    <main>
      <slot />
    </main>
    <Footer club={club} pages={items} />
  </body>
</html>
